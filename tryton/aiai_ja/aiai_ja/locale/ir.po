msgctxt "model:ir.message,text:msg_too_many_relations_found"
msgid ""
"Found too many relation for %(value)r in \"%(model)s\" at row %(row)d and "
"column %(column)d."
msgstr "「%(model)s」で %(value)r の関連先が多すぎます(%(row)d 行目、%(column)d 列目)。"

msgctxt "model:ir.message,text:msg_translation_export_default_lang"
msgid "To export translations, the default language must be \"English\"."
msgstr "翻訳をエクスポートするには、既定の言語を「英語」にしてください。"

msgctxt "model:ir.message,text:msg_translation_overridden"
msgid ""
"You can not export translation \"%(name)s\" because it has been overridden "
"by module \"%(overriding_module)s\"."
msgstr "翻訳「%(name)s」はモジュール「%(overriding_module)s」で上書きされているため、エクスポートできません。"

msgctxt "model:ir.message,text:msg_translation_set_default_lang"
msgid "To set translations, the default language must be \"English\"."
msgstr "翻訳を設定するには、既定の言語を「英語」にしてください。"

msgctxt "model:ir.message,text:msg_trigger_exclusive"
msgid ""
"You can not select \"On Time\" and any other on the same time, they are "
"mutually exclusive."
msgstr "「定刻」はほかの条件と同時に選べません。"

msgctxt "model:ir.message,text:msg_trigger_invalid_condition"
msgid ""
"Condition \"%(condition)s\" is not a valid PYSON expression for trigger "
"\"%(trigger)s\"."
msgstr "トリガー「%(trigger)s」の条件「%(condition)s」は正しい PYSON 式ではありません。"

msgctxt "model:ir.message,text:msg_value_syntax_error"
msgid ""
"Syntax error for %(value)r in \"%(field)s\" of \"%(model)s\" at row %(row)d "
"and column %(column)d."
msgstr ""
"「%(model)s」の「%(field)s」の %(value)r に構文エラーがあります(%(row)d 行目、%(column)d 列目)。"

msgctxt "model:ir.message,text:msg_view_invalid_xml"
msgid "Invalid XML for view \"%(name)s\"."
msgstr "画面「%(name)s」の XML が正しくありません。"

msgctxt "model:ir.message,text:msg_view_search_invalid_domain"
msgid "Invalid domain or search criteria \"%(domain)s\" for search \"%(search)s\"."
msgstr "検索「%(search)s」のドメインまたは検索条件「%(domain)s」が正しくありません。"

msgctxt "model:ir.message,text:msg_view_tree_optional_type"
msgid "You cannot store optional on view \"%(view)s\"."
msgstr "画面「%(view)s」には表示の選択を保存できません。"

msgctxt ""
"model:ir.message,text:msg_view_tree_width_field_occurrence_user_unique"
msgid "A user can set only one width per occurrence of field."
msgstr "利用者が設定できる幅は、項目ごとに1つだけです。"

